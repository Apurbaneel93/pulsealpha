# Every variable is optional. With none set, PulseAlpha scans live Yahoo
# Finance data and ranks picks with its deterministic rules engine.
# No database is needed: market data and AI results live in Next.js's server
# cache (unstable_cache + revalidate), and Signal History lives in each
# browser's localStorage.

# Server-side Gemini key. Keep it here (Vercel → Settings → Environment
# Variables), never in the repo. The owner may also paste a personal key in the
# "API Setup" tab; that key stays in that one browser.
GEMINI_API_KEY=

# Owner passcode: unlocks the owner-only API Setup tab at /owner. 12+ characters
# (20+ from a password manager is better). Unset or shorter = owner mode is off
# and the tab is hidden for everyone. Changing it signs every device out.
OWNER_PASSCODE=

# gemini-2.5-flash was retired on 16 Oct 2026. Override if Google renames again.
GEMINI_MODEL=gemini-3.5-flash
